# Copy this file to keystore.properties (git-ignored) and fill in your own key to sign a release build.
# Without keystore.properties the release build is unsigned; for a test build pass -PsignWithDebugKey=true.
storeFile=/path/to/your-release-key.jks
storePassword=CHANGE_ME
keyAlias=your-key-alias
keyPassword=CHANGE_ME
