<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.metrowin.keyboard.settings.KeyboardPreview android:key="size_preview" />
    <Preference android:key="size_try" android:title="@string/pref_try_title" android:summary="@string/pref_try_summary" />
    <Preference android:key="size_calibrate" android:title="@string/pref_calibrate_title" android:summary="@string/pref_calibrate_summary" />
    <SwitchPreferenceCompat android:key="calibration_on" android:title="@string/pref_calibrate_on_title" android:summary="@string/pref_calibrate_on_summary" android:defaultValue="true" />
    <Preference android:key="size_calibrate_reset" android:title="@string/pref_calibrate_reset_title" />
    <SeekBarPreference android:key="key_height" android:title="@string/pref_key_height_title" android:defaultValue="100" android:max="140" app:min="60" app:seekBarIncrement="5" app:showSeekBarValue="true" />
    <SeekBarPreference android:key="key_height_land" android:title="@string/pref_key_height_land_title" android:defaultValue="100" android:max="140" app:min="60" app:seekBarIncrement="5" app:showSeekBarValue="true" />
    <SeekBarPreference android:key="keyboard_width" android:title="@string/pref_width_title" android:summary="@string/pref_width_summary" android:defaultValue="100" android:max="100" app:min="55" app:seekBarIncrement="5" app:showSeekBarValue="true" />
    <ListPreference android:key="keyboard_align" android:title="@string/pref_align_title" android:entries="@array/align_names" android:entryValues="@array/align_values" android:defaultValue="center" app:useSimpleSummaryProvider="true" />
    <SeekBarPreference android:key="key_gap" android:title="@string/pref_gap_title" android:defaultValue="3" android:max="10" app:min="0" app:showSeekBarValue="true" />
    <SwitchPreferenceCompat android:key="language_key" android:title="@string/pref_language_key_title" android:summary="@string/pref_language_key_summary" android:defaultValue="false" />
    <SwitchPreferenceCompat android:key="number_row" android:title="@string/pref_number_row_title" android:summary="@string/pref_number_row_summary" android:defaultValue="false" />
    <SwitchPreferenceCompat android:key="key_hints" android:title="@string/pref_hints_title" android:summary="@string/pref_hints_summary" android:defaultValue="true" />
    <SeekBarPreference android:key="bottom_padding" android:title="@string/pref_bottom_padding_title" android:summary="@string/pref_bottom_padding_summary" android:defaultValue="0" android:max="64" app:min="0" app:seekBarIncrement="2" app:showSeekBarValue="true" />
</PreferenceScreen>
