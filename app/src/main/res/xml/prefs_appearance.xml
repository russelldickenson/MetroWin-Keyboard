<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ListPreference android:key="theme_style" android:title="@string/pref_theme_style_title" android:entries="@array/theme_style_names" android:entryValues="@array/theme_style_values" android:defaultValue="classic" app:useSimpleSummaryProvider="true" />
    <ListPreference android:key="theme_mode" android:title="@string/pref_theme_mode_title" android:entries="@array/theme_mode_names" android:entryValues="@array/theme_mode_values" android:defaultValue="system" app:useSimpleSummaryProvider="true" />
    <ListPreference android:key="key_font" android:title="@string/pref_key_font_title" android:entries="@array/key_font_names" android:entryValues="@array/key_font_values" android:defaultValue="opensans" app:useSimpleSummaryProvider="true" />
    <ListPreference android:key="key_weight" android:title="@string/pref_key_weight_title" android:entries="@array/key_weight_values" android:entryValues="@array/key_weight_values" android:defaultValue="300" app:useSimpleSummaryProvider="true" />
    <Preference android:key="accent_pick" android:title="@string/pref_accent_title" android:summary="@string/pref_accent_summary" />
    <SwitchPreferenceCompat android:key="dynamic_color" android:title="@string/pref_dynamic_title" android:summary="@string/pref_dynamic_summary" android:defaultValue="true" />
    <SwitchPreferenceCompat android:key="oled_black" android:title="@string/pref_oled_title" android:summary="@string/pref_oled_summary" android:defaultValue="false" />
    <PreferenceCategory android:title="@string/cat_adaptive">
        <SwitchPreferenceCompat android:key="adaptive_color" android:title="@string/pref_adaptive_title" android:summary="@string/pref_adaptive_summary" android:defaultValue="false" />
    </PreferenceCategory>
</PreferenceScreen>
